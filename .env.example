# Bambi Service API의 origin (scheme+host)만 기록한다. (CLAUDE.md §6)
# 끝에 슬래시(/)나 /api 를 붙이지 않는다. /api 는 요청 경로에서 결합한다.
# 비우면(미설정·빈값·공백) same-origin 상대경로 /api/* 로 요청한다 → 운영 nginx 프록시 전제.
# 로컬 예시: http://localhost
NEXT_PUBLIC_API_URL=

# Claude·ChatGPT·Codex에 사용자가 등록할 공개 MCP Streamable HTTP URL.
NEXT_PUBLIC_MCP_SERVER_URL=http://localhost:8000/mcp
