    "test:report-delta": "node --test tests/report-delta.test.mjs",
    "test:privacy": "node --test tests/privacy-page.test.mjs",
    "test:wiki-interest-ux": "node --test tests/wiki-interest-ux.test.mjs",
    "test:morning-report-visibility": "node --test tests/morning-report-visibility.test.mjs",
    "test:report-back-link": "node --test tests/report-back-link.test.mjs",
